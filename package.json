{
  "name": "infrahub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "wrangler pages dev --port 8788",
    "dev:backend:remote": "wrangler pages dev --port 8788 --remote",
    "dev:remote": "concurrently \"npm run dev:frontend\" \"npm run dev:backend:remote\"",
    "deploy:testing": "npm run build && npx wrangler pages deploy dist --project-name infrahub --branch testing-d1",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.1",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/query-sync-storage-persister": "^5.90.18",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-persist-client": "^5.90.18",
    "hono": "^4.12.8",
    "jspdf": "^3.0.4",
    "konva": "^10.0.12",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.1",
    "recharts": "^3.5.0",
    "use-image": "^1.1.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.57.0"
  }
}
